# Multi-stage build on the slim base: dependencies are installed in a build stage
# and only the installed packages are copied into the final image.
FROM python:3.12-slim AS build
RUN pip install --no-cache-dir --target /deps "psycopg[binary]==3.2.3"

FROM python:3.12-slim
COPY --from=build /deps /usr/local/lib/python3.12/site-packages
RUN useradd --uid 10001 --no-create-home wallet
WORKDIR /app
COPY app/ /app/
USER 10001
EXPOSE 8080
CMD ["python3", "api.py"]
