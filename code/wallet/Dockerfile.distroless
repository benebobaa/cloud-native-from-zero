# Distroless: no shell, no package manager; only Python, libc and the app.
# Build and runtime stages use the same Debian release and Python minor version (3.13).
FROM python:3.13-slim-trixie AS build
RUN pip install --no-cache-dir --target /deps "psycopg[binary]==3.2.3"

FROM gcr.io/distroless/python3-debian13:nonroot
COPY --from=build /deps /deps
ENV PYTHONPATH=/deps
WORKDIR /app
COPY app/ /app/
EXPOSE 8080
CMD ["api.py"]
